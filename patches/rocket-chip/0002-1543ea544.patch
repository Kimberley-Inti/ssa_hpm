@@ -721,7 +788,9 @@ class Rocket(tile: RocketTile)(implicit p: Parameters) extends CoreModule()(p)
         Mux(wb_ctrl.csr =/= CSR.N, csr.io.rw.rdata,
           Mux(wb_ctrl.mul, mul.map(_.io.resp.bits.data).getOrElse(wb_reg_wdata),
             wb_reg_wdata))))
