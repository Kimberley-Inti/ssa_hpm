From 469bfac7de26bfbb03298787ad030898c6de24c9 Mon Sep 17 00:00:00 2001
From: Kimberley-Inti <KimIntizar@hotmail.com>
Date: Wed, 11 Nov 2026 00:19:30 +0800
Subject: [PATCH] Attribute optional standard DTLB PTW-request HPM3 intervals
 to SSA records

---
 scripts/gen-ssa-rom.py                 |  28 +++--
 src/main/resources/ssa/microcode.S     |  22 ++++
 src/main/scala/rocket/CSR.scala        |   7 +-
 src/main/scala/rocket/RocketCore.scala | 137 ++++++++++++++++++++++++-
 4 files changed, 179 insertions(+), 15 deletions(-)

diff --git a/scripts/gen-ssa-rom.py b/scripts/gen-ssa-rom.py
index 0e73f88b7..c8cf7dcb4 100644
--- a/scripts/gen-ssa-rom.py
+++ b/scripts/gen-ssa-rom.py
@@ -5,20 +5,26 @@ root = pathlib.Path(__file__).resolve().parents[1]
 parser = argparse.ArgumentParser()
 parser.add_argument('--check', action='store_true')
 args = parser.parse_args()
-with tempfile.TemporaryDirectory() as d:
-    obj = pathlib.Path(d) / 'microcode.elf'
-    prefix = os.environ.get('CROSS_COMPILE', 'riscv64-unknown-elf-')
-    subprocess.run([prefix+'gcc', '-nostdlib', '-march=rv64g', '-mabi=lp64d',
-                    '-Wl,-Ttext=0', '-Wl,--no-relax', str(root/'src/main/resources/ssa/microcode.S'), '-o', str(obj)], check=True)
-    dump = subprocess.check_output([prefix+'objdump', '-d', str(obj)], text=True)
-words = re.findall(r'^\s*[0-9a-f]+:\s+([0-9a-f]{8})\s', dump, re.M)
-assert 0 < len(words) <= 256
 p = root/'src/main/scala/rocket/RocketCore.scala'
 s = p.read_text()
-rom = '    val ssa_rom_data = Seq(\n' + ',\n'.join('      "h'+w+'"' for w in words) + '\n    )'
-updated = re.sub(r'    val ssa_rom_data = Seq\(.*?\n    \)', lambda _: rom, s, count=1, flags=re.S)
+updated = s
+counts = []
+for event, name in [(False, 'ssa_rom_data'), (True, 'ssa_event_rom_data')]:
+    with tempfile.TemporaryDirectory() as d:
+        obj = pathlib.Path(d) / 'microcode.elf'
+        prefix = os.environ.get('CROSS_COMPILE', 'riscv64-unknown-elf-')
+        subprocess.run([prefix+'gcc', '-nostdlib', '-march=rv64g', '-mabi=lp64d',
+                        *(['-DSSA_HPM_EVENT'] if event else []), '-Wl,-Ttext=0', '-Wl,--no-relax',
+                        str(root/'src/main/resources/ssa/microcode.S'), '-o', str(obj)], check=True)
+        dump = subprocess.check_output([prefix+'objdump', '-d', str(obj)], text=True)
+    words = re.findall(r'^\s*[0-9a-f]+:\s+([0-9a-f]{8})\s', dump, re.M)
+    assert 0 < len(words) <= 256
+    counts.append(len(words))
+    rom = '    val '+name+' = Seq(\n' + ',\n'.join('      "h'+w+'"' for w in words) + '\n    )'
+    updated, n = re.subn(r'    val '+name+r' = Seq\(.*?\n    \)', lambda _: rom, updated, count=1, flags=re.S)
+    assert n == 1, name
 if args.check:
     assert s == updated, 'SCCodeTable differs from ssa/microcode.S; run ssa/gen_rom.py'
 else:
     p.write_text(updated)
-print(f'SCCodeTable: {len(words)} instructions ({len(words)*4} bytes)')
+print('SCCodeTable instruction counts, ABI1/ABI2:', counts)
diff --git a/src/main/resources/ssa/microcode.S b/src/main/resources/ssa/microcode.S
index f91623223..402fc83fc 100644
--- a/src/main/resources/ssa/microcode.S
+++ b/src/main/resources/ssa/microcode.S
@@ -55,6 +55,9 @@ allocate:
     sd zero, 16(t6)
     sd zero, 24(t6)
     sd zero, 32(t6)
+#ifdef SSA_HPM_EVENT
+    sd zero, 40(t6)          # ABI2: DTLB accepted PTW requests
+#endif
     lwu t0, 0(a4)
     sd t0, 88(t6)
     sw t5, 0(a4)
@@ -71,6 +74,10 @@ push:
     sd t0, 8(t6)
     sd t1, 16(t6)
     sd a3, 24(t6)
+#ifdef SSA_HPM_EVENT
+    csrr a4, 0xb03
+    sd a4, 32(t6)          # ABI2 fourth entry snapshot
+#endif
     j normal_exit
 full:
     ld t0, 24(t2)
@@ -91,6 +98,9 @@ pop:
     csrr t1, minstret
     li a3, 0x200bff8
     ld a3, 0(a3)
+#ifdef SSA_HPM_EVENT
+    csrr a4, 0xb03
+#endif
     slli t6, t3, 6
     sub t6, t2, t6
     ld t5, 0(t6)
@@ -100,6 +110,12 @@ pop:
     sub t1, t1, t4
     ld t4, 24(t6)
     sub a3, a3, t4
+#ifdef SSA_HPM_EVENT
+    ld t4, 32(t6)
+    sub a4, a4, t4
+    li a5, 0xffffffffff
+    and a4, a4, a5         # counter3 is 40 bits, including wrap
+#endif
     li t6, -37748736
     add t6, a0, t6
     slli t5, t5, 7
@@ -113,6 +129,12 @@ pop:
     ld t4, 32(t6)
     add t4, t4, a3
     sd t4, 32(t6)
+#ifdef SSA_HPM_EVENT
+    ld t4, 40(t6)
+    add t4, t4, a4
+    and t4, t4, a5
+    sd t4, 40(t6)
+#endif
     addi t3, t3, -1
     sd t3, 0(t2)
 normal_exit:
diff --git a/src/main/scala/rocket/CSR.scala b/src/main/scala/rocket/CSR.scala
index 12cd403bc..a5a1d75ed 100644
--- a/src/main/scala/rocket/CSR.scala
+++ b/src/main/scala/rocket/CSR.scala
@@ -290,6 +290,7 @@ class CSRFileIO(implicit p: Parameters) extends CoreBundle
   //[Edited1]========================
   val scbasereg = Output(UInt(xLen.W))
   val ssa_context_active = Output(Bool())
+  val ssa_event_enabled = Output(Bool())
   //=================================
 
   val vector = usingVector.option(new Bundle {
@@ -491,6 +492,8 @@ class CSRFile(
   // traps in software. Privilege, rather than a per-hart nesting history,
   // defines application notifications in the opt-in Linux policy.
   val reg_ssa_user_only = RegInit(false.B)
+  val reg_ssa_event_enabled = RegInit(false.B)
+  io.ssa_event_enabled := reg_ssa_event_enabled
   io.ssa_context_active := Mux(reg_ssa_user_only, reg_mstatus.prv === PRV.U,
     !reg_ssa_trap_depth.orR) && !reg_ssa_trap_overflow
   //===================================
@@ -687,7 +690,7 @@ class CSRFile(
 
   //[Edited 3]==========================
   read_mapping += 0x800 -> reg_scbasereg
-  read_mapping += 0x5c0 -> reg_ssa_user_only.asUInt
+  read_mapping += 0x5c0 -> Cat(reg_ssa_event_enabled, reg_ssa_user_only)
   // Custom user read-only CSR: depth[7:0], sticky fail-closed overflow[8].
   read_mapping += 0xcc0 -> Cat(reg_ssa_trap_overflow, reg_ssa_trap_depth)
   //====================================
@@ -1250,7 +1253,7 @@ class CSRFile(
 
     //[Edited 4]===============================================
     when (decoded_addr(0x800))         {reg_scbasereg := wdata}
-    when (decoded_addr(0x5c0))         {reg_ssa_user_only := wdata(0)}
+    when (decoded_addr(0x5c0))         {reg_ssa_user_only := wdata(0); reg_ssa_event_enabled := (if (nPerfCounters > 0) wdata(1) else false.B)}
     //=========================================================
 
     if (mtvecWritable)
