From 01b1aa69bce35971c9912e5706860d848adc6900 Mon Sep 17 00:00:00 2001
From: Kimberley-Inti <KimIntizar@hotmail.com>
Date: Sat, 28 Mar 2026 08:01:21 +0800
Subject: [PATCH] modified code sequence

---
 tests/Makefile       |  2 +-
 tests/ssa_csr_test.s | 53 ---------------------------------
 tests/test_ssa.S     | 70 --------------------------------------------
 3 files changed, 1 insertion(+), 124 deletions(-)
 delete mode 100644 tests/ssa_csr_test.s
 delete mode 100644 tests/test_ssa.S

diff --git a/tests/Makefile b/tests/Makefile
index 54959bf048d9e3b8992c5589924a5b7016cc832c..b5dbcc6f2a7787a605ad26b33d41ac0fada9556e 100644
--- a/tests/Makefile
+++ b/tests/Makefile
@@ -6,7 +6,7 @@ LDFLAGS= -static
 include libgloss.mk
 
 PROGRAMS = pwm blkdev accum charcount nic-loopback big-blkdev pingd \
-           streaming-passthrough streaming-fir nvdla spiflashread spiflashwrite fft gcd
+           streaming-passthrough streaming-fir nvdla spiflashread spiflashwrite fft gcd test_ssa
 
 spiflash.img: spiflash.py
 	python3 $<
diff --git a/tests/ssa_csr_test.s b/tests/ssa_csr_test.s
deleted file mode 100644
index f1635cbec53b7936990e204b3ab4a90fc06f2c9b..0000000000000000000000000000000000000000
--- a/tests/ssa_csr_test.s
+++ /dev/null
@@ -1,53 +0,0 @@
-.section .text
-.global _start
-.align 4
-
-_start:
-    csrw    mie, zero
-    la      t0, trap_handler
-    csrw    mtvec, t0
-
-    # ---------------------------
-    # CSR 测试逻辑
-    # ---------------------------
-    li      t0, 0x12345678
-    csrw    0x800, t0       # 写 CSR
-    li      t1, 0
-    csrr    t1, 0x800       # 读 CSR
-    bne     t0, t1, fail    # 比较
-
-pass:
-    # [关键修复] 强制把 Cache 数据刷入 DRAM，让仿真器看到！
-    fence
-    
-    li      t0, 1
-    la      t1, tohost
-    sd      t0, 0(t1)
-    j       pass
-
-fail:
-    # 同样加上 fence
-    fence
-    
-    li      t0, 3       # 错误码 3: 数据不匹配
-    la      t1, tohost
-    sd      t0, 0(t1)
-    j       fail
-
-.align 4
-trap_handler:
-    fence
-    li      t0, 5       # 错误码 5: 触发了非法指令异常
-    la      t1, tohost
-    sd      t0, 0(t1)
-    j       trap_handler
-
-# ---------------------------
-# Linker Script 会把这个段放到 DRAM 里
-# ---------------------------
-.section .tohost
-.align 6
-.globl tohost
-tohost: .dword 0
-.globl fromhost
-fromhost: .dword 0
diff --git a/tests/test_ssa.S b/tests/test_ssa.S
deleted file mode 100644
index e787b092bd77f9b7df4547847e1c9044021b9270..0000000000000000000000000000000000000000
--- a/tests/test_ssa.S
+++ /dev/null
@@ -1,70 +0,0 @@
-    .section .text
-    .globl _start
-
-_start:
-    # 0. 初始化栈指针 (SP) 到 DRAM 的安全区域
-    # SCStack 位于 0x80001000，我们把 SP 设远一点避免冲突
-    li sp, 0x80004000
-
-    # 1. 简单的初始化
-    li t0, 100
-
-    # 2. 调用函数 A
-    # 【硬件预期】检测到 JAL -> 触发 SSA 写内存 (Stack[0] = PC)
-    jal ra, func_a
-
-  
-    
-    # 加载 SCStack 基地址
-    li s0, 0x80100000       
-    
-    # 读取第 0 个条目 (对应 func_a 的调用点 PC)
-    # 【验证点 1】s1 (x9) 应该等于上面 'jal ra, func_a' 的地址
-    ld s1, 0(s0)            
-    
-    # 读取第 1 个条目 (对应 func_b 的调用点 PC)
-    # 【验证点 2】s2 (x18) 应该等于 func_a 内部 'jal ra, func_b' 的地址
-    ld s2, 8(s0)            
-
-    # ===============================================
-
-    # 3. 结束 (通知仿真器成功退出)
-    # 向 tohost 写 1 表示正常退出 (Pass)
-    li t0, 1
-    la t1, tohost
-    sd t0, 0(t1)
-
-loop:
-    j loop
-
-func_a:
-   
-    mv t1, ra      # 把返回地址(main)备份到 t1
-
-    addi t0, t0, 1
-
-    # 4. 嵌套调用函数 B
-    # 【硬件预期】检测到 JAL -> 触发 SSA 写内存 (Stack[1] = PC)
-    jal ra, func_b
-
-    # 从 t1 恢复返回地址
-    mv ra, t1
-
-    # 5. 函数 A 返回
-    # 【硬件预期】检测到 JALR -> 触发 SSA 弹栈 (Ptr 减 1)
-    ret
-
-func_b:
-    addi t0, t0, 2
-    
-    # 6. 函数 B 返回
-    # 【硬件预期】检测到 JALR -> 触发 SSA 弹栈 (Ptr 减 1)
-    ret
-
-
-.section .tohost
-.align 6
-.globl tohost
-tohost: .dword 0
-.globl fromhost
-fromhost: .dword 0
